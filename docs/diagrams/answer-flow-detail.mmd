flowchart TB
 subgraph COURSE["Course answer engine"]
    direction TB
        F["Find relevant content<br>for the answer"]
        G["Tell user the question<br>is not supported"]
        H["Prepare source content<br>for the model"]
        I["Ask the model for an answer"]
        J{"Is the answer<br>format valid?"}
        K["Return issue to app"]
        L{"Do the sources<br>match the content found?"}
        M["Ask once more<br>to fix the format"]
        N["Return a safe refusal"]
        O["Return answer result"]
        P["Apply source-check rules"]
  end
    A(["User asks a question"]) --> B["App receives question"]
    B --> C["Find relevant content<br>for safety review"]
    C --> D["Save content for later safety check"] & E["Send question to answer engine"]
    E --> F
    F -- Nothing relevant found --> G
    F -- Relevant content found --> H
    H --> I
    I -- Model responds --> J
    I -- Service problem or timeout --> K
    J -- Yes --> L
    J -- No, first try --> M
    M --> I
    J -- No, retry also failed --> N
    L -- Yes --> O
    L -- No --> P
    P --> O
    G --> O
    N --> O
    K --> Q["App returns a safe refusal"]
    Q --> R["Save failure path<br>content found → model call → decision"]
    O --> S{"Safety check:<br>blocked instruction?"}
    D --> S
    S -- Yes --> T["Return a safe refusal"]
    S -- No --> U["Show the answer"]
    T --> V["Save safety decision"]
    U --> W["Save normal result"]

     A:::entry
     B:::wrapper
     C:::wrapper
     D:::data
     E:::wrapper
     F:::course
     G:::refusal
     H:::course
     I:::model
     J:::decision
     K:::exception
     L:::decision
     M:::retry
     N:::refusal
     O:::courseResult
     P:::retry
     Q:::refusal
     R:::trace
     S:::decision
     T:::refusal
     U:::success
     V:::trace
     W:::trace
    classDef entry fill:#0f172a,stroke:#38bdf8,color:#f8fafc,stroke-width:2px
    classDef wrapper fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px
    classDef course fill:#ede9fe,stroke:#7c3aed,color:#2e1065,stroke-width:2px
    classDef model fill:#f3e8ff,stroke:#9333ea,color:#3b0764,stroke-width:2px
    classDef decision fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:2px
    classDef retry fill:#ffedd5,stroke:#ea580c,color:#7c2d12,stroke-width:2px
    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px
    classDef refusal fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px
    classDef exception fill:#ffe4e6,stroke:#e11d48,color:#881337,stroke-width:2px
    classDef data fill:#e2e8f0,stroke:#64748b,color:#0f172a,stroke-width:2px
    classDef trace fill:#f1f5f9,stroke:#64748b,color:#334155,stroke-width:2px
    classDef courseResult fill:#f5f3ff,stroke:#8b5cf6,color:#3b0764,stroke-width:2px
    style COURSE fill:#faf5ff,stroke:#7c3aed,stroke-width:2px,color:#2e1065