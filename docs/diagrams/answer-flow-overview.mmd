flowchart TD
    A(["User asks a question"]):::entry
    B["Retrieve and save content"]:::wrapper
    C["Generate answer or refusal"]:::engine
    D{"Service problem<br/>or timeout?"}:::decision
    E["Return safe refusal<br/>and record failure"]:::refusal
    F{"Content contains<br/>blocked pattern?"}:::decision
    G["Return safe refusal<br/>and record decision"]:::refusal
    H["Show result<br/>and record outcome"]:::success

    A --> B --> C --> D
    D -->|"Yes"| E
    D -->|"No"| F
    F -->|"Yes"| G
    F -->|"No"| H

    classDef entry fill:#0f172a,stroke:#38bdf8,color:#f8fafc,stroke-width:2px;
    classDef wrapper fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px;
    classDef engine fill:#ede9fe,stroke:#7c3aed,color:#2e1065,stroke-width:2px;
    classDef decision fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:2px;
    classDef refusal fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px;
    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;